---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: 'fr' | 'en';
}

const {
  title = 'Granit — Vos équipes soignent. Granit gère le reste.',
  description = "Granit déploie des agents IA qui automatisent les tâches administratives de vos équipes de santé. Branché sur vos outils existants. Opérationnel en 48h.",
  lang = 'fr',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Granit" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fonts: Libre Caslon Display · Newsreader · Azeret Mono · Just Me Again Down Here -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@400;500&family=Just+Me+Again+Down+Here&family=Libre+Caslon+Display&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
